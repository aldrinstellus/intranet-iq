# =============================================================================
# dIQ - Intranet IQ Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Clerk Authentication (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# OpenAI Configuration (Required for embeddings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Anthropic Configuration (Optional - for AI summaries)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Elasticsearch Configuration (Required for enterprise search)
# -----------------------------------------------------------------------------
# Local Docker development
ELASTICSEARCH_URL=http://localhost:9200

# For Elastic Cloud (production)
# ELASTICSEARCH_URL=https://your-deployment.es.us-east-1.aws.cloud.es.io:9243
# ELASTICSEARCH_API_KEY=your-base64-api-key

# Index name (defaults to 'diq-content')
ELASTICSEARCH_INDEX=diq-content

# -----------------------------------------------------------------------------
# Development Notes
# -----------------------------------------------------------------------------
#
# To start Elasticsearch locally with Docker:
#   cd apps/intranet-iq
#   docker compose -f docker-compose.elasticsearch.yml up -d
#
# Access Kibana at: http://localhost:5601
# Access Elasticsearch at: http://localhost:9200
#
# To index content:
#   POST /api/elasticsearch/index { "action": "full-sync" }
#
# To generate demo data:
#   POST /api/elasticsearch/index { "action": "generate-demo", "options": { "count": 200 } }
